<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>AspNetCore.Ignite</PackageId>
        <Description>Apache Ignite 2 thin client integration for ASP.NET Core: dependency injection, options, logging, health checks and resilient connections.</Description>
        <Authors>dradoaica</Authors>
        <Company>dradoaica</Company>
        <Copyright>Copyright (c) 2022 Radoaica Danut Cosmin &amp; Rysavy Ondrej</Copyright>
        <PackageTags>apache-ignite;ignite;cache;aspnetcore;thin-client</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/dradoaica/AspNetCore.Ignite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dradoaica/AspNetCore.Ignite.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- breaking changes of the version are in docs/upgrading.md -->
        <PackageReleaseNotes>Upgrading (breaking changes): https://github.com/dradoaica/AspNetCore.Ignite/blob/main/docs/upgrading.md</PackageReleaseNotes>
        <!-- SourceLink is built into the .NET SDK; ship symbols and embed untracked sources for debugging -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Apache.Ignite"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
        <PackageReference Include="Polly"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AspNetCore.Ignite.UnitTests"/>
    </ItemGroup>

</Project>
